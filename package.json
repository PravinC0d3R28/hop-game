{
  "name": "hop-game",
  "version": "1.0.0",
  "description": "HOP - A faithful, standalone reimplementation of the BounceTiles arcade game. Modular TypeScript, fully customizable.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:dev": "vite --mode dev --port 3001",
    "build": "tsc && vite build",
    "build:analyze": "tsc && vite build --mode analyze && node scripts/collect-maps.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "game",
    "threejs",
    "gsap",
    "arcade",
    "infinite-runner",
    "bounce"
  ],
  "license": "MIT",
  "dependencies": {
    "gsap": "^3.14.2",
    "three": "^0.152.0"
  },
  "devDependencies": {
    "@types/three": "^0.152.0",
    "playwright": "^1.63.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.0"
  }
}
